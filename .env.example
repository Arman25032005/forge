FORGE_ENVIRONMENT=development
FORGE_LOG_LEVEL=INFO
FORGE_DATABASE_URL=postgresql+asyncpg://forge:forge@localhost:5432/forge
FORGE_REDIS_URL=redis://localhost:6379/0
FORGE_API_HOST=0.0.0.0
FORGE_API_PORT=8000

# Required for the agent runtime (POST /agents/runs) to actually reason —
# without it the endpoint returns 503. See docs/architecture/phase-5-agent-runtime.md.
FORGE_ANTHROPIC_API_KEY=
FORGE_ANTHROPIC_MODEL=claude-opus-5
FORGE_AGENT_MAX_STEPS=8

# Refresh tokens (POST /auth/refresh, /auth/logout)
FORGE_REFRESH_TOKEN_DAYS=7

# Rate limiting on /auth/login and /auth/register. "memory" (default) is
# single-process only — correct for this dev environment, wrong for a
# multi-instance deployment, which should set this to "redis". See
# docs/architecture/phase-9-red-team-hardening.md.
FORGE_RATE_LIMIT_BACKEND=memory
FORGE_LOGIN_RATE_LIMIT_MAX=5
FORGE_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
FORGE_REGISTER_RATE_LIMIT_MAX=5
FORGE_REGISTER_RATE_LIMIT_WINDOW_SECONDS=60

NEXT_PUBLIC_API_URL=http://localhost:8000
